{
  "expo": {
    "name": "DataLens Analyzer",
    "slug": "datalens-analyser",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "datalensanalyzer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/datalens-splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "android": {
      "package": "com.datalens.analyzer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/datalens-logo-with-backdrop.png",
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.datalens.analyzer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DataLens Analyzer to access your camera to capture charts for analysis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DataLens Analyzer to access your photos to select charts for analysis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ff239d3c-5a2b-4c20-88d8-99b5dd3dbbc3"
      },
      "router": {}
    },
    "owner": "qunanis-organization"
  }
}
